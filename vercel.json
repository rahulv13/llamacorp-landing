{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/raw-index",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/seo"
    }
  ]
}
