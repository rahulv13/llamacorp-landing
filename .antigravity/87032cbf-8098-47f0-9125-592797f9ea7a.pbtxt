dth=device-width, initial-scale=1.0\" />\n    <title>llamacorp</title>\n</head>\n\n<body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.jsx\"></script>\n</body>\n\n</html>\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@theme {\n    --font-inter: \'Inter\', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    \n    --color-bg-primary: #fcfcfc;\n    --color-text-primary: #111111;\n    --color-text-secondary: #555555;\n}\n\n@layer base {\n    * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n    }\n\n    body {\n        font-family: var(--font-inter);\n        background-color: var(--color-bg-primary);\n        color: var(--color-text-primary);\n        min-height: 100vh;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        -webkit-font-smoothing: antialiased;\n        -moz-osx-font-smoothing: grayscale;\n    }\n}\n\n@keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n}\n\n.animate-marquee {\n    animation: marquee 40s linear infinite;\n}\n\n@keyframes scroll-up {\n    0% { transform: translateY(0); }\n    100% { transform: translateY(-50%); }\n}\n\n@keyframes scroll-down {\n    0% { transform: translateY(-50%); }\n    100% { transform: translateY(0); }\n}\n\n.animate-scroll-up-slow { animation: scroll-up 45s linear infinite; }\n.animate-scroll-down-medium { animation: scroll-down 30s linear infinite; }\n.animate-scroll-up-medium { animation: scroll-up 35s linear infinite; }\n.animate-scroll-down-fast { animation: scroll-down 25s linear infinite; }\n\n.hover-pause:hover {\n    animation-play-state: paused;\n}\n\n```"
